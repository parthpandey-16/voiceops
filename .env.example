# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible provider) ---
LLM_PROVIDER=gemini            # gemini | openai | groq | ollama
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# LLM_MODEL=gemini-2.5-flash   # optional override

# --- Gnani speech (required for Step 4 / run.py) ---
GNANI_API_KEY=

# --- Optional ---
# DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026
# EMBEDDINGS=fastembed         # fastembed | api | none
# TOP_K=6
# STT_LANGUAGE=en-IN           # en-IN handles English + Hinglish; hi-IN for Hindi callers
# TTS_MODEL=timbre-v2.5
# TTS_VOICE=Kaveri             # English voice; TTS_VOICE_HI=Nalini, TTS_VOICE_HINGLISH=Poorvi
